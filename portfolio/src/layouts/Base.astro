---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogDescription: string;
}

const { title, description, ogDescription } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='15' fill='%23e9cf72'/%3E%3Cpath d='M18 46V18h16c8 0 13 4 13 11 0 5-3 9-8 11l9 6H36l-9-7v7h-9zm9-17h7c2 0 3-1 3-2s-1-2-3-2h-7v4z' fill='%232d2634'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main class="page" id="main">
      <slot />
    </main>
  </body>
</html>
